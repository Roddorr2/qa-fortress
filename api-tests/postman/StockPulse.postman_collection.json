  "item": [
    {
      "name": "Sales",
      "item": [
        {
          "name": "Create Sale (Contract Test)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const schema = {",
                  "  \"type\": \"object\",",
                  "  \"properties\": {",
                  "    \"id\": { \"type\": \"number\" },",
                  "    \"productId\": { \"type\": \"number\" },",
                  "    \"quantity\": { \"type\": \"number\" },",
                  "    \"totalPrice\": { \"type\": \"number\" },",
                  "    \"status\": { \"type\": \"string\" }",
                  "  },",
                  "  \"required\": [\"id\", \"productId\", \"quantity\", \"totalPrice\", \"status\"]",
                  "};",
                  "",
                  "pm.test(\"Schema is valid (No breaking changes)\", function () {",
                  "    pm.response.to.have.jsonSchema(schema);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 101,\n  \"quantity\": 2,\n  \"branchId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sales",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sales"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
