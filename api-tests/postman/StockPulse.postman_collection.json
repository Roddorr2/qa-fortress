          "name": "POST /v1/auth/login — Credenciales inválidas (FR-07)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Credenciales inválidas retornan 401 (FR-07)\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test(\"La respuesta no contiene accessToken\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.not.have.property('accessToken');",
                  "});",
                  "",
                  "pm.test(\"El rechazo de auth es rápido (< 2000ms)\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
