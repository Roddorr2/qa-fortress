        {
          "name": "GET /v1/stock/report — Reporte agregado (FR-12)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"El reporte de stock retorna 200 (FR-12)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"El reporte contiene una lista no vacía de items (FR-12)\", function () {",
                  "    pm.expect(json).to.have.property('items');",
                  "    pm.expect(json.items).to.be.an('array').that.is.not.empty;",
                  "});",
                  "",
                  "pm.test(\"El reporte tiene tiempo de respuesta aceptable (< 3000ms)\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});"
                ],
